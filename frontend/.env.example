# KPIMS Frontend — environment variables (copy to .env / .env.local)
# Vite only exposes variables prefixed with VITE_.

# REST API base path. In the dev sandbox, Vite proxies /api to the backend.
# In production, point this to the public API base, e.g. https://kpims.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Business timezone used for Jalali date display
VITE_APP_TIMEZONE=Asia/Tehran

# Show demo-credentials hint on the login page (disable in production)
VITE_SHOW_DEMO_HINT=true
