# KPIMS Backend — environment variables (copy to .env and fill values)
# NEVER commit the real .env file. In production, use the platform Secrets manager.

# PostgreSQL connection string (embedded dev database defaults to port 5433)
DATABASE_URL=postgresql://kpims:CHANGE_ME@127.0.0.1:5433/kpims?schema=public

# HTTP server
PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=8h
BCRYPT_ROUNDS=10

# Business timezone (Jalali calendar display is derived from this)
APP_TIMEZONE=Asia/Tehran

# ---- Phase 7: AI assistant (optional — DB settings take precedence) ----
# Default: local Ollama (free, offline, filter-proof). Any OpenAI-compatible
# endpoint (e.g. an Iranian gateway) works by changing these values.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:7b
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=90000
